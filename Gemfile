source "https://rubygems.org"

# 1. We specify the core Jekyll engine directly.
gem "jekyll", "~> 4.3"

# 2. We specify the SASS converter version that works with our theme.
gem "jekyll-sass-converter", "~> 2.0"

# 3. We add the missing libraries for modern Ruby.
gem "bigdecimal"
gem "webrick" # This is another standard library that is now external.

# 4. We specify other common plugins from the original github-pages gem.
gem "jekyll-feed", "~> 0.15"
gem "jekyll-seo-tag", "~> 2.6"
gem "jekyll-sitemap", "~> 1.4"