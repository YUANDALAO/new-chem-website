---
layout: default
title: Chemical Library
---

<style>
  .chemlib-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .chemlib-header h1 {
    font-size: 2.5em;
    font-weight: 700;
    color: #2c3540;
    margin-bottom: 12px;
  }

  .chemlib-header p {
    font-size: 1.1em;
    color: #5a6471;
  }

  .filter-section {
    background: #f8f9fb;
    padding: 20px 25px;
    border-radius: 12px;
    margin-bottom: 35px;
  }

  .search-box {
    display: flex;
    gap: 15px;
    margin-bottom: 18px;
  }

  .search-box input {
    flex: 1;
    padding: 11px 18px;
    border: 1px solid #d0d5dd;
    border-radius: 8px;
    font-size: 1em;
  }

  .search-box button {
    padding: 11px 28px;
    background: #8b9cb6;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }

  .search-box button:hover {
    background: #7a8ba3;
  }

  .filter-tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-tag {
    padding: 7px 15px;
    background: white;
    border: 1px solid #d0d5dd;
    border-radius: 18px;
    font-size: 0.9em;
    cursor: pointer;
  }

  .filter-tag:hover,
  .filter-tag.active {
    background: #8b9cb6;
    color: white;
    border-color: #8b9cb6;
  }

  .compound-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 28px;
    margin-bottom: 50px;
  }

  .compound-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    height: 380px;
    display: flex;
    flex-direction: column;
  }

  .compound-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(139, 156, 182, 0.15);
    border-color: #8b9cb6;
    transition: all 0.3s;
  }

  .structure-container {
    background: #ffffff;
    padding: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 240px;
    border-bottom: 1px solid #e5e7eb;
  }

  .structure-container img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: none !important;
    image-rendering: crisp-edges;
  }

  .compound-info {
    padding: 18px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .compound-id {
    font-size: 1.3em;
    font-weight: 700;
    color: #2c3540;
    margin-bottom: 8px;
    text-align: center;
  }

  .compound-name {
    font-size: 0.88em;
    color: #5a6471;
    text-align: center;
    margin-bottom: 12px;
    line-height: 1.4;
    min-height: 38px;
  }

  .compound-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .compound-tag {
    padding: 4px 9px;
    background: #e8eef7;
    color: #8b9cb6;
    border-radius: 4px;
    font-size: 0.75em;
    font-weight: 500;
  }

  .series-title {
    font-size: 1.8em;
    font-weight: 700;
    color: #2c3540;
    margin: 50px 0 28px;
    padding-bottom: 10px;
    border-bottom: 3px solid #8b9cb6;
  }

  .series-title:first-of-type {
    margin-top: 10px;
  }

  .stats-bar {
    display: flex;
    gap: 30px;
    justify-content: center;
    margin-bottom: 35px;
    padding: 18px;
    background: #f8f9fb;
    border-radius: 12px;
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    font-size: 2em;
    font-weight: 700;
    color: #8b9cb6;
  }

  .stat-label {
    font-size: 0.9em;
    color: #5a6471;
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .compound-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
    .compound-card {
      height: 350px;
    }
    .structure-container {
      height: 200px;
    }
  }
</style>

<div class="chemlib-header">
  <h1>Chemical Library</h1>
  <p>Explore our collection with interactive 2D structures</p>
</div>

<div class="stats-bar">
  <div class="stat-item">
    <div class="stat-number">150+</div>
    <div class="stat-label">Compounds</div>
  </div>
  <div class="stat-item">
    <div class="stat-number">15</div>
    <div class="stat-label">Series</div>
  </div>
  <div class="stat-item">
    <div class="stat-number">95%</div>
    <div class="stat-label">Purity</div>
  </div>
</div>

<div class="filter-section">
  <div class="search-box">
    <input type="text" placeholder="Search by ID...">
    <button>Search</button>
  </div>
  <div class="filter-tags">
    <div class="filter-tag active">All</div>
    <div class="filter-tag">Heterocycles</div>
    <div class="filter-tag">Scaffolds</div>
    <div class="filter-tag">Drug-like</div>
  </div>
</div>

