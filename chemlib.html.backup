    <div class="structure-container">
      <img src="/assets/images/compounds/B003.svg" alt="B003">
    </div>
    <div class="compound-info">
      <div class="compound-id">B003</div>
      <div class="compound-name">5-Bromobenzothiazole-2-one</div>
      <div class="compound-tags">
        <span class="compound-tag">Halogenated</span>
